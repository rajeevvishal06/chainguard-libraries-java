<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>chainguard-remediated</id>
      <username>${env.CGR_MAVEN_USER}</username>
      <password>${env.CGR_MAVEN_PASS}</password>
    </server>
    <server>
      <id>chainguard-java</id>
      <username>${env.CGR_MAVEN_USER}</username>
      <password>${env.CGR_MAVEN_PASS}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>chainguard-libraries</id>
      <repositories>
        <!-- 1️⃣ Chainguard Remediated Java repo (first priority) -->
        <repository>
          <id>chainguard-remediated</id>
          <url>https://libraries.cgr.dev/java-remediated/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>

        <!-- 1️⃣ Chainguard Java repo (second priority) -->
        <repository>
          <id>chainguard-java</id>
          <url>https://libraries.cgr.dev/java/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>

        <!-- 2️⃣ Maven Central fallback -->
        <repository>
          <id>central</id>
          <url>invalid</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>

      <!-- Plugins and their dependencies (e.g. spring-core for spring-boot:repackage)
           resolve through pluginRepositories, not repositories -->
      <pluginRepositories>
        <!-- 1️⃣ Chainguard Remediated Java repo (first priority) -->
        <pluginRepository>
          <id>chainguard-remediated</id>
          <url>https://libraries.cgr.dev/java-remediated/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>

        <!-- 1️⃣ Chainguard Java repo (second priority) -->
        <pluginRepository>
          <id>chainguard-java</id>
          <url>https://libraries.cgr.dev/java/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>

        <!-- 2️⃣ Maven Central fallback for plugins not available from Chainguard -->
        <pluginRepository>
          <id>central</id>
          <url>invalid</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>chainguard-libraries</activeProfile>
  </activeProfiles>
</settings>
